{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "build SFML",
            "command": "C:\\mingw64-sfml\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe",
                "-I",
                "C:\\SFML-2.6.1\\include",
                "-L",
                "C:\\SFML-2.6.1\\lib",
                "-lsfml-graphics",
                "-lsfml-window",
                "-lsfml-system"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}